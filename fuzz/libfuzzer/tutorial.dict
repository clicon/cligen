# Command/keyword tokens from tutorial.cli, for fuzz_system's libFuzzer
# -dict (or AFL++ -x). Unlike cligen.dict (generic .cli grammar tokens, used
# to fuzz spec syntax), this is the vocabulary of *input commands* accepted
# by the fixed tutorial.cli spec that fuzz_system loads.
"hello"
"world"
"ip"
"tcp"
"udp"
"access-list"
"permit"
"ex"
"aa"
"bb"
"ff"
"ca"
"cb"
"dd"
"ee"
"values"
"interface"
"eth0"
"eth1"
"secret"
"change"
"prompt"
"recurse"
"increment"
"quit"
"tree"
"add"
"del"
"x"
"y"
"z"
"1.2.3.4"
"0.0.0.0"
"255.255.255.255"
"\x0a"
